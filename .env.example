# Base de datos
DB_NAME=branding_erp
DB_USER=postgres
DB_PASS=
DB_HOST=localhost
DB_PORT=5432

# JWT Secret
JWT_SECRET=

# Puerto del servidor
PORT=4000

# Entorno
NODE_ENV=development

# ==========================================
# 🔔 CONFIGURACIÓN FIREBASE NOTIFICACIONES
# ==========================================
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
# ⚠️ IMPORTANTE: Necesitas la clave privada completa de Firebase
# Ve a Firebase Console > Configuración del proyecto > Cuentas de servicio > Generar nueva clave privada
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_CERT_URL=

# Configuración de notificaciones
NOTIFICATION_ENABLED=true
CRON_ENABLED=true
NOTIFICATION_ADVANCE_MINUTES=5

# ==========================================
# CONFIGURACIÓN ADICIONAL
# ==========================================
# Timezone
TZ=America/La_Paz

# CORS Origins (separados por coma)
CORS_ORIGINS=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutos
RATE_LIMIT_MAX_REQUESTS=100  # máximo 100 requests por ventana

# Email (opcional para notificaciones)
#EMAIL_HOST=smtp.gmail.com
#EMAIL_PORT=587
#EMAIL_USER=tu-correo@gmail.com
#EMAIL_PASS=
# Solo para scripts/testNotifications.js (token FCM de un dispositivo de prueba)
TEST_FCM_TOKEN=
